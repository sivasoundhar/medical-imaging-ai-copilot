# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=Medical Imaging AI Copilot
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- LLM provider selection (Day 9+) ---
LLM_PROVIDER=ollama
# Optional: a second provider to fall back to if the primary can't
# produce a valid/grounded/safe response after retrying (Day 11). Must
# be one of groq / ollama / claude / mock, and its own credentials below
# must be filled in. Leave blank for no fallback (single-provider,
# matches every prior day's behavior).
LLM_FALLBACK_PROVIDER=

# Groq (cloud) -- check Groq's current production model list before
# deploying (e.g. openai/gpt-oss-120b); no default is guessed here.
GROQ_API_KEY=
GROQ_MODEL=

# Ollama (local) -- llama3.2 is the model this project's real Day
# 9/10/11 testing was actually run against; pull it first with
# `ollama pull llama3.2` if you don't already have it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Claude (cloud, alternative provider) -- defaults to claude-opus-5 in
# code if left blank; set explicitly for anything beyond local testing.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
